# Copiar como .env. Aquí solo va configuración, nunca contraseñas:
# las credenciales se leen de AWS Secrets Manager en tiempo de ejecución.

# Punto 1
PUNTO1_SECRET_NAME=taller/punto1/demo

# Punto 3 (DocumentDB por túnel SSH; la contraseña se lee de Secrets Manager)
DOCDB_CLUSTER_ID=p3-docdb
DOCDB_HOST=localhost
DOCDB_PORT=27017
DOCDB_NAME=actividad
DOCDB_COLLECTION=customers

# Punto 4 (Neptune con endpoint público + IAM; sin contraseñas)
NEPTUNE_CLUSTER_ID=p4-neptune

# Punto 5 (Redshift Serverless + Data API; la contraseña del admin la administra Redshift en Secrets Manager)
REDSHIFT_NAMESPACE=p5-namespace
REDSHIFT_WORKGROUP=p5-workgroup
REDSHIFT_DATABASE=actividad
P5_S3_BUCKET=actividad-aws-p5-807872461370

# Punto 6 (Glue + Athena; sin secretos, solo IAM)
GLUE_DATABASE=p6_ventas
P6_S3_BUCKET=actividad-aws-p6-807872461370
